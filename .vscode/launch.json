{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Exemplo",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-ninja-vs2026-debug/Debug/bin/exemplo.exe",
            "args": [
                "--hb:gtnap"
            ],
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${env:AWS_SDK_ROOT}\\msvc64\\Release\\bin"
                }
            ],
            "cwd": "${workspaceFolder}/contrib/gtnap/tests/cuademo/gtnap_cualib"
        },
        {
            "name": "Designer",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-ninja-vs2026-debug/Debug/bin/napdesign.exe",
            "args": [],
            "cwd": "${workspaceFolder}/contrib/gtnap/tests/cuademo/gtnap_cualib"
        },
        {
            "name": "Debugger",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-ninja-vs2026-debug/Debug/bin/gtnapdeb.exe",
            "args": [
                "35",
                "100"
            ],
            "cwd": "${workspaceFolder}/contrib/gtnap/tests/cuademo/gtnap_cualib"
        },
        {
            "name": "Exemplo (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-ninja-gcc-debug/Debug/bin/exemplo",
            "args": [
                "--hb:gtnap"
            ],
            "cwd": "${workspaceFolder}/contrib/gtnap/tests/cuademo/gtnap_cualib",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/contrib/hbaws/awssdk/bin/linux/gcc:/usr/lib/libreoffice/program:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Designer (Linux)",
